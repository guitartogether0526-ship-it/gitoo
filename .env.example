# GUITAR TOGETHER — 환경변수 템플릿
# 실제 값은 .env.local (로컬) / Vercel 프로젝트 환경변수 (배포) 에 넣으세요.

# Supabase (대시보드 → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# 서버 전용 — 브라우저에 노출 금지 (NEXT_PUBLIC_ 접두사 사용 금지)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# 관리자(admin) 로그인 비밀번호 — 서버에서만 검증. 미설정 시 코드 기본값 사용.
# 실제 값은 .env.local / Vercel 환경변수에만 넣고, 이 템플릿엔 절대 넣지 마세요.
ADMIN_PASSWORD=<admin-password>

# 이메일 발송 (아이디/비밀번호 찾기) — Gmail SMTP. 서버 전용.
# 미설정 시 메일 대신 화면에 결과를 표시(데모 폴백).
# GMAIL_APP_PASSWORD 는 일반 비밀번호가 아니라 "앱 비밀번호" 16자리입니다.
#   생성: Google 계정 → 보안 → 2단계 인증 ON → 앱 비밀번호 → 16자리 발급
GMAIL_USER=yourclub@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# (선택) 표시용 발신자 주소. 미설정 시 GMAIL_USER 사용.
MAIL_FROM=yourclub@gmail.com
# (선택) 회원가입 신청 알림을 받을 관리자 메일. 미설정 시 코드 기본값 사용.
SIGNUP_NOTIFY_EMAIL=admin@yourclub.com

# 웹푸시(공지 알림) — VAPID 키. `npx web-push generate-vapid-keys` 로 생성.
# PUBLIC 은 클라이언트 노출용(NEXT_PUBLIC), PRIVATE 는 서버 전용(절대 노출 금지).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:admin@yourclub.com
